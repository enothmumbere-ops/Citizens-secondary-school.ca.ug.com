{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized system administrator registry entry.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "fullName": { "type": "string", "maxLength": 150 },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "createdAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user profile and role assignment.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "teacher", "student", "pending"], "maxLength": 20 },
        "status": { "type": "string", "enum": ["active", "inactive", "pending"], "maxLength": 20 },
        "linkedEntityId": { "type": "string", "maxLength": 128 },
        "schoolPayCode": { "type": "string", "maxLength": 64 },
        "initials": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "UserInvite": {
      "title": "UserInvite",
      "description": "Admin-issued role authorization invite mapped to user email.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "teacher", "student"], "maxLength": 20 },
        "linkedEntityId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 150 },
        "schoolPayCode": { "type": "string", "maxLength": 64 },
        "initials": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["pending", "claimed", "revoked"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role", "fullName", "status", "createdAt", "updatedAt"]
    },
    "SchoolSettings": {
      "title": "SchoolSettings",
      "description": "Official school identity, term dates, and grading configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "schoolCode": { "type": "string", "maxLength": 32 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "motto": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 200 },
        "phones": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 150 },
        "headTeacherName": { "type": "string", "maxLength": 150 },
        "bursarName": { "type": "string", "maxLength": 150 },
        "bursarInitials": { "type": "string", "maxLength": 16 },
        "currentAcademicYearId": { "type": "string", "maxLength": 128 },
        "currentTermId": { "type": "string", "maxLength": 128 },
        "thisTermHas": { "type": "string", "maxLength": 200 },
        "nextTermBegins": { "type": "string", "maxLength": 120 },
