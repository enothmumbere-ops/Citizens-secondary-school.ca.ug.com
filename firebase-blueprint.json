  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "System administrator authorization registry."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Authenticated user account profiles and roles."
    },
    "/userInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/UserInvite" },
      "description": "Admin-managed role invitations keyed by sanitized email."
