        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolCode", "schoolName", "motto", "address", "phones", "email", "updatedAt"]
    },
    "AcademicYear": {
      "title": "AcademicYear",
      "description": "Academic year record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolCode": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 40 },
        "isCurrent": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "archived"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolCode", "name", "isCurrent", "status", "createdAt"]
    },
    "Term": {
      "title": "Term",
      "description": "Academic term within an academic year.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolCode": { "type": "string", "maxLength": 32 },
        "academicYearId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "enum": ["Term I", "Term II", "Term III"], "maxLength": 20 },
        "startDate": { "type": "string", "maxLength": 40 },
        "endDate": { "type": "string", "maxLength": 40 },
        "nextTermBegins": { "type": "string", "maxLength": 40 },
        "isCurrent": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolCode", "academicYearId", "name", "isCurrent", "createdAt"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "Senior class S.1 through S.6 with streams and class teacher.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolCode": { "type": "string", "maxLength": 32 },
        "code": { "type": "string", "enum": ["S.1", "S.2", "S.3", "S.4", "S.5", "S.6"], "maxLength": 10 },
        "name": { "type": "string", "maxLength": 80 },
        "level": { "type": "string", "enum": ["O-Level", "A-Level"], "maxLength": 20 },
        "streams": { "type": "array" },
        "classTeacherId": { "type": "string", "maxLength": 128 },
        "classTeacherName": { "type": "string", "maxLength": 150 },
        "classTeacherInitials": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolCode", "code", "name", "level", "streams", "createdAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Approved academic subject and class availability.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolCode": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 100 },
