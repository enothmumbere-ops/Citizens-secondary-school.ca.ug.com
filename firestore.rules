      allow create: if isAdmin() && isValidId(teacherId) && isValidTeacher(incoming()) &&
        incoming().id == teacherId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(teacherId) && isValidTeacher(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['staffNumber', 'fullName', 'initials', 'email', 'phone', 'gender', 'authUid', 'assignedClasses', 'assignedSubjects', 'adminUids', 'status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(teacherId);
    }

    match /teacherAssignments/{assignmentId} {
      allow get: if isVerified() && isValidId(assignmentId) && (isAdmin() || resource.data.teacherUid == request.auth.uid);
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        resource.data.teacherUid == request.auth.uid ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids)
      );
      allow create: if isAdmin() && isValidId(assignmentId) && isValidTeacherAssignment(incoming()) &&
        incoming().id == assignmentId &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/teachers/$(incoming().teacherId)) &&
        exists(/databases/$(database)/documents/subjects/$(incoming().subjectId));
      allow update: if isAdmin() && isValidId(assignmentId) && isValidTeacherAssignment(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['teacherId', 'teacherUid', 'teacherName', 'teacherInitials', 'classCode', 'stream', 'subjectId', 'subjectName', 'academicYearId', 'termId', 'adminUids']);
      allow delete: if isAdmin() && isValidId(assignmentId);
    }

    match /students/{studentId} {
      allow get: if isVerified() && isValidId(studentId) && (
        isAdmin() ||
        resource.data.studentAuthUid == request.auth.uid ||
        (isTeacher() && request.auth.uid in resource.data.authorizedTeacherUids)
      );
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids) ||
        (resource.data.authorizedTeacherUids is list && request.auth.uid in resource.data.authorizedTeacherUids) ||
        resource.data.studentAuthUid == request.auth.uid
      );
      allow create: if isAdmin() && isValidId(studentId) && isValidStudent(incoming()) &&
        incoming().id == studentId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/academicYears/$(incoming().academicYearId));
      allow update: if isAdmin() && isValidId(studentId) && isValidStudent(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['studentNumber', 'fullName', 'gender', 'schoolPayCode', 'dateOfBirth', 'admissionDate', 'classCode', 'stream', 'academicYearId', 'status', 'authUid', 'email', 'studentAuthUid', 'photoUrl', 'authorizedTeacherUids', 'adminUids', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(studentId);
    }

    match /assessmentRecords/{recordId} {
      allow get: if isVerified() && isValidId(recordId) && (
        isAdmin() ||
        resource.data.studentAuthUid == request.auth.uid ||
        (isTeacher() && request.auth.uid in resource.data.authorizedTeacherUids)
      );
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids) ||
        (resource.data.authorizedTeacherUids is list && request.auth.uid in resource.data.authorizedTeacherUids) ||
        resource.data.studentAuthUid == request.auth.uid
      );
      allow create: if isVerified() && isValidId(recordId) && isValidAssessmentRecord(incoming()) &&
        incoming().id == recordId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId)) &&
        exists(/databases/$(database)/documents/subjects/$(incoming().subjectId)) &&
        exists(/databases/$(database)/documents/terms/$(incoming().termId)) && (
          isAdmin() ||
          (isTeacher() && incoming().status != 'approved' && request.auth.uid in incoming().authorizedTeacherUids && incoming().teacherUid == request.auth.uid)
        );
      allow update: if isVerified() && isValidId(recordId) && isValidAssessmentRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().studentId == existing().studentId &&
        incoming().subjectId == existing().subjectId &&
        incoming().termId == existing().termId &&
        incoming().academicYearId == existing().academicYearId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isTeacher() &&
            existing().status != 'approved' &&
            incoming().status in ['draft', 'submitted'] &&
            request.auth.uid in existing().authorizedTeacherUids &&
            incoming().diff(existing()).affectedKeys().hasOnly(['cumulativeAiScore', 'identifier', 'aiDescriptor', 'formativeScore', 'summativeScore', 'totalScore', 'grade', 'descriptor', 'teacherInitials', 'teacherComment', 'teacherUid', 'status', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(recordId);
    }

    match /studentTermSummaries/{summaryId} {
      allow get: if isVerified() && isValidId(summaryId) && (
        isAdmin() ||
        resource.data.studentAuthUid == request.auth.uid ||
        (isTeacher() && request.auth.uid in resource.data.authorizedTeacherUids)
      );
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids) ||
        (resource.data.authorizedTeacherUids is list && request.auth.uid in resource.data.authorizedTeacherUids) ||
        resource.data.studentAuthUid == request.auth.uid
      );
      allow create: if isVerified() && isValidId(summaryId) && isValidStudentTermSummary(incoming()) &&
        incoming().id == summaryId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId)) && (
          isAdmin() ||
          (isTeacher() && incoming().status == 'draft' && request.auth.uid in incoming().authorizedTeacherUids)
        );
      allow update: if isVerified() && isValidId(summaryId) && isValidStudentTermSummary(incoming()) &&
        incoming().id == existing().id &&
        incoming().studentId == existing().studentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isTeacher() &&
            existing().status != 'published' &&
            request.auth.uid in existing().authorizedTeacherUids &&
            incoming().diff(existing()).affectedKeys().hasOnly(['classTeacherComment', 'classTeacherName', 'classTeacherInitials', 'projectSubject', 'projectTitle', 'projectPhase', 'projectScore', 'projectRemarks', 'projectSupervisor', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(summaryId);
    }

    match /attendance/{attendanceId} {
      allow get: if isVerified() && isValidId(attendanceId) && (
        isAdmin() ||
        resource.data.studentAuthUid == request.auth.uid ||
        (isTeacher() && request.auth.uid in resource.data.authorizedTeacherUids)
      );
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids) ||
        (resource.data.authorizedTeacherUids is list && request.auth.uid in resource.data.authorizedTeacherUids) ||
        resource.data.studentAuthUid == request.auth.uid
      );
      allow create: if isVerified() && isValidId(attendanceId) && isValidAttendanceRecord(incoming()) &&
        incoming().id == attendanceId &&
        incoming().recordedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId)) && (
          isAdmin() ||
          (isTeacher() && request.auth.uid in incoming().authorizedTeacherUids)
        );
      allow update: if isVerified() && isValidId(attendanceId) && isValidAttendanceRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().studentId == existing().studentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'recordedByUid', 'recordedByName']) && (
          isAdmin() ||
          (isTeacher() && request.auth.uid in existing().authorizedTeacherUids)
        );
      allow delete: if isAdmin() && isValidId(attendanceId);
    }

    match /feesRecords/{feeId} {
      allow get: if isVerified() && isValidId(feeId) && (isAdmin() || resource.data.studentAuthUid == request.auth.uid);
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids) ||
        resource.data.studentAuthUid == request.auth.uid
      );
      allow create: if isAdmin() && isValidId(feeId) && isValidFeesRecord(incoming()) &&
        incoming().id == feeId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId));
      allow update: if isAdmin() && isValidId(feeId) && isValidFeesRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().studentId == existing().studentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['feesRequired', 'amountPaid', 'balance', 'bursarComment', 'bursarName', 'bursarInitials', 'paymentHistory', 'adminUids', 'updatedByUid', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(feeId);
    }

    match /reportCards/{reportId} {
      allow get: if isVerified() && isValidId(reportId) && (
        isAdmin() ||
        (resource.data.studentAuthUid == request.auth.uid && resource.data.published == true)
      );
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids) ||
        (resource.data.studentAuthUid == request.auth.uid && resource.data.published == true)
      );
      allow create: if isAdmin() && isValidId(reportId) && isValidReportCard(incoming()) &&
        incoming().id == reportId &&
        incoming().generatedAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId));
      allow update: if isAdmin() && isValidId(reportId) && isValidReportCard(incoming()) &&
        incoming().id == existing().id &&
        incoming().studentId == existing().studentId &&
        incoming().generatedAt == existing().generatedAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(reportId);
    }

    match /excelImports/{importId} {
      allow get: if isAdmin() && isValidId(importId);
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids)
      );
      allow create: if isAdmin() && isValidId(importId) && isValidExcelImport(incoming()) &&
        incoming().id == importId &&
        incoming().uploadedByUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(importId);
    }

    match /auditLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids)
      );
      allow create: if isVerified() && isValidId(logId) && isValidAuditLog(incoming()) &&
        incoming().id == logId &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        (isAdmin() || isTeacher());
      allow update: if false;
      allow delete: if false;
    }
  }
