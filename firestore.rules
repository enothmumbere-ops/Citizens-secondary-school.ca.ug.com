rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'enothmumbere@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isTeacher() {
      return isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isOptString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptNumber(data, field, minVal, maxVal) {
      return !(field in data) || data[field] == null || (
        (data[field] is int || data[field] is float) &&
        data[field] >= minVal &&
        data[field] <= maxVal
      );
    }

    function isBoundedList(listVal, maxItems) {
      return listVal is list && listVal.size() <= maxItems && (listVal.size() == 0 || listVal[0] is string);
    }

    // 3. Entity Validation Blueprints

    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'fullName', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150 &&
        isOptString(data, 'grantedBy', 128) &&
        data.createdAt is timestamp;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'linkedEntityId', 'schoolPayCode', 'initials', 'inviteId', 'adminUids', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 150 &&
        data.role in ['admin', 'teacher', 'student', 'pending'] &&
        data.status in ['active', 'inactive', 'pending'] &&
        isOptString(data, 'linkedEntityId', 128) &&
        isOptString(data, 'schoolPayCode', 64) &&
        isOptString(data, 'initials', 16) &&
        isOptString(data, 'inviteId', 128) &&
        (!( 'adminUids' in data ) || isBoundedList(data.adminUids, 15)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserInvite(data) {
      return data.keys().hasAll(['id', 'email', 'role', 'fullName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'email', 'role', 'linkedEntityId', 'fullName', 'schoolPayCode', 'initials', 'status', 'adminUids', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.role in ['admin', 'teacher', 'student'] &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150 &&
        data.status in ['pending', 'claimed', 'revoked'] &&
        isOptString(data, 'linkedEntityId', 128) &&
        isOptString(data, 'schoolPayCode', 64) &&
        isOptString(data, 'initials', 16) &&
        (!( 'adminUids' in data ) || isBoundedList(data.adminUids, 15)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSchoolSettings(data) {
      return data.keys().hasAll(['id', 'schoolCode', 'schoolName', 'motto', 'address', 'phones', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'schoolCode', 'schoolName', 'motto', 'address', 'phones', 'email', 'headTeacherName', 'bursarName', 'bursarInitials', 'currentAcademicYearId', 'currentTermId', 'thisTermHas', 'nextTermBegins', 'gradingConfig', 'updatedAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.schoolCode == 'CSS_KASESE' &&
        data.schoolName is string && data.schoolName.size() >= 2 && data.schoolName.size() <= 200 &&
        data.motto is string && data.motto.size() <= 120 &&
        data.address is string && data.address.size() <= 200 &&
        data.phones is string && data.phones.size() <= 120 &&
        data.email is string && data.email.size() <= 150 &&
        isOptString(data, 'headTeacherName', 150) &&
        isOptString(data, 'bursarName', 150) &&
        isOptString(data, 'bursarInitials', 16) &&
        isOptString(data, 'currentAcademicYearId', 128) &&
        isOptString(data, 'currentTermId', 128) &&
        isOptString(data, 'thisTermHas', 200) &&
        isOptString(data, 'nextTermBegins', 120) &&
        (!( 'gradingConfig' in data ) || data.gradingConfig is map) &&
        data.updatedAt is timestamp;
    }

    function isValidAcademicYear(data) {
      return data.keys().hasAll(['id', 'schoolCode', 'name', 'isCurrent', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'schoolCode', 'name', 'isCurrent', 'status', 'createdAt']) &&
        isValidId(data.id) &&
        data.schoolCode == 'CSS_KASESE' &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 40 &&
        data.isCurrent is bool &&
        data.status in ['active', 'archived'] &&
        data.createdAt is timestamp;
    }

    function isValidTerm(data) {
      return data.keys().hasAll(['id', 'schoolCode', 'academicYearId', 'name', 'isCurrent', 'createdAt']) &&
        data.keys().hasOnly(['id', 'schoolCode', 'academicYearId', 'name', 'startDate', 'endDate', 'nextTermBegins', 'isCurrent', 'createdAt']) &&
        isValidId(data.id) &&
        data.schoolCode == 'CSS_KASESE' &&
        isValidId(data.academicYearId) &&
        data.name in ['Term I', 'Term II', 'Term III'] &&
        isOptString(data, 'startDate', 40) &&
        isOptString(data, 'endDate', 40) &&
        isOptString(data, 'nextTermBegins', 40) &&
        data.isCurrent is bool &&
        data.createdAt is timestamp;
    }

    function isValidSchoolClass(data) {
      return data.keys().hasAll(['id', 'schoolCode', 'code', 'name', 'level', 'streams', 'createdAt']) &&
        data.keys().hasOnly(['id', 'schoolCode', 'code', 'name', 'level', 'streams', 'classTeacherId', 'classTeacherName', 'classTeacherInitials', 'createdAt']) &&
        isValidId(data.id) &&
        data.schoolCode == 'CSS_KASESE' &&
        data.code in ['S.1', 'S.2', 'S.3', 'S.4', 'S.5', 'S.6'] &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.level in ['O-Level', 'A-Level'] &&
        isBoundedList(data.streams, 20) &&
        isOptString(data, 'classTeacherId', 128) &&
        isOptString(data, 'classTeacherName', 150) &&
        isOptString(data, 'classTeacherInitials', 16) &&
        data.createdAt is timestamp;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'schoolCode', 'name', 'allowedClasses', 'isCompulsory', 'createdAt']) &&
        data.keys().hasOnly(['id', 'schoolCode', 'name', 'code', 'allowedClasses', 'isCompulsory', 'createdAt']) &&
        isValidId(data.id) &&
        data.schoolCode == 'CSS_KASESE' &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        isOptString(data, 'code', 32) &&
        isBoundedList(data.allowedClasses, 10) &&
        data.isCompulsory is bool &&
        data.createdAt is timestamp;
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['id', 'staffNumber', 'fullName', 'initials', 'email', 'status', 'adminUids', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'staffNumber', 'fullName', 'initials', 'email', 'phone', 'gender', 'authUid', 'assignedClasses', 'assignedSubjects', 'adminUids', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.staffNumber is string && data.staffNumber.size() >= 1 && data.staffNumber.size() <= 64 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 150 &&
        data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 16 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        isOptString(data, 'phone', 40) &&
        (!( 'gender' in data ) || data.gender in ['M', 'F']) &&
        isOptString(data, 'authUid', 128) &&
        (!( 'assignedClasses' in data ) || isBoundedList(data.assignedClasses, 15)) &&
        (!( 'assignedSubjects' in data ) || isBoundedList(data.assignedSubjects, 25)) &&
        isBoundedList(data.adminUids, 15) &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTeacherAssignment(data) {
      return data.keys().hasAll(['id', 'teacherId', 'teacherName', 'classCode', 'subjectId', 'subjectName', 'academicYearId', 'termId', 'adminUids', 'createdAt']) &&
        data.keys().hasOnly(['id', 'teacherId', 'teacherUid', 'teacherName', 'teacherInitials', 'classCode', 'stream', 'subjectId', 'subjectName', 'academicYearId', 'termId', 'adminUids', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.teacherId) &&
        isOptString(data, 'teacherUid', 128) &&
        data.teacherName is string && data.teacherName.size() >= 2 && data.teacherName.size() <= 150 &&
        isOptString(data, 'teacherInitials', 16) &&
        data.classCode in ['S.1', 'S.2', 'S.3', 'S.4', 'S.5', 'S.6'] &&
        isOptString(data, 'stream', 40) &&
        isValidId(data.subjectId) &&
        data.subjectName is string && data.subjectName.size() >= 2 && data.subjectName.size() <= 100 &&
        isValidId(data.academicYearId) &&
        isValidId(data.termId) &&
        isBoundedList(data.adminUids, 15) &&
        data.createdAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'studentNumber', 'fullName', 'gender', 'schoolPayCode', 'classCode', 'academicYearId', 'status', 'authorizedTeacherUids', 'adminUids', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'studentNumber', 'fullName', 'gender', 'schoolPayCode', 'dateOfBirth', 'admissionDate', 'classCode', 'stream', 'academicYearId', 'status', 'authUid', 'email', 'studentAuthUid', 'photoUrl', 'authorizedTeacherUids', 'adminUids', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.studentNumber is string && data.studentNumber.size() >= 1 && data.studentNumber.size() <= 64 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 160 &&
        data.gender in ['M', 'F'] &&
        data.schoolPayCode is string && data.schoolPayCode.size() <= 64 &&
        isOptString(data, 'dateOfBirth', 40) &&
        isOptString(data, 'admissionDate', 40) &&
        data.classCode in ['S.1', 'S.2', 'S.3', 'S.4', 'S.5', 'S.6'] &&
        isOptString(data, 'stream', 40) &&
        isValidId(data.academicYearId) &&
        data.status in ['active', 'inactive', 'archived', 'transferred'] &&
        isOptString(data, 'authUid', 128) &&
        isOptString(data, 'email', 200) &&
        isOptString(data, 'studentAuthUid', 128) &&
        isOptString(data, 'photoUrl', 100000) &&
        isBoundedList(data.authorizedTeacherUids, 35) &&
        isBoundedList(data.adminUids, 15) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAssessmentRecord(data) {
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'classCode', 'academicYearId', 'termId', 'subjectId', 'subjectName', 'status', 'authorizedTeacherUids', 'adminUids', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'studentId', 'studentName', 'studentAuthUid', 'schoolPayCode', 'classCode', 'stream', 'academicYearId', 'termId', 'subjectId', 'subjectName', 'cumulativeAiScore', 'identifier', 'aiDescriptor', 'formativeScore', 'summativeScore', 'totalScore', 'grade', 'descriptor', 'teacherInitials', 'teacherComment', 'teacherUid', 'authorizedTeacherUids', 'adminUids', 'status', 'approvedBy', 'sourceImportId', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.studentId) &&
        data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 160 &&
        isOptString(data, 'studentAuthUid', 128) &&
        isOptString(data, 'schoolPayCode', 64) &&
        data.classCode in ['S.1', 'S.2', 'S.3', 'S.4', 'S.5', 'S.6'] &&
        isOptString(data, 'stream', 40) &&
        isValidId(data.academicYearId) &&
        isValidId(data.termId) &&
        isValidId(data.subjectId) &&
        data.subjectName is string && data.subjectName.size() >= 2 && data.subjectName.size() <= 100 &&
        isOptNumber(data, 'cumulativeAiScore', 0, 3) &&
        isOptNumber(data, 'identifier', 1, 3) &&
        isOptString(data, 'aiDescriptor', 40) &&
        isOptNumber(data, 'formativeScore', 0, 20) &&
        isOptNumber(data, 'summativeScore', 0, 80) &&
        isOptNumber(data, 'totalScore', 0, 100) &&
        isOptString(data, 'grade', 16) &&
        isOptString(data, 'descriptor', 60) &&
        isOptString(data, 'teacherInitials', 16) &&
        isOptString(data, 'teacherComment', 400) &&
        isOptString(data, 'teacherUid', 128) &&
        isBoundedList(data.authorizedTeacherUids, 35) &&
        isBoundedList(data.adminUids, 15) &&
        data.status in ['draft', 'submitted', 'approved'] &&
        isOptString(data, 'approvedBy', 128) &&
        isOptString(data, 'sourceImportId', 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudentTermSummary(data) {
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'classCode', 'academicYearId', 'termId', 'status', 'authorizedTeacherUids', 'adminUids', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'studentId', 'studentName', 'gender', 'schoolPayCode', 'studentAuthUid', 'classCode', 'stream', 'academicYearId', 'termId', 'averageAiIdentifier', 'averageAiDescriptor', 'averageTotalScore', 'averageGrade', 'averageFinal', 'level', 'position', 'result', 'classTeacherComment', 'classTeacherName', 'classTeacherInitials', 'bursarComment', 'bursarName', 'bursarInitials', 'headTeacherComment', 'headTeacherName', 'projectSubject', 'projectTitle', 'projectPhase', 'projectScore', 'projectRemarks', 'projectSupervisor', 'authorizedTeacherUids', 'adminUids', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.studentId) &&
        data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 160 &&
        isOptString(data, 'gender', 8) &&
        isOptString(data, 'schoolPayCode', 64) &&
        isOptString(data, 'studentAuthUid', 128) &&
        data.classCode in ['S.1', 'S.2', 'S.3', 'S.4', 'S.5', 'S.6'] &&
        isOptString(data, 'stream', 40) &&
        isValidId(data.academicYearId) &&
        isValidId(data.termId) &&
        isOptNumber(data, 'averageAiIdentifier', 0, 3) &&
        isOptString(data, 'averageAiDescriptor', 40) &&
        isOptNumber(data, 'averageTotalScore', 0, 100) &&
        isOptString(data, 'averageGrade', 16) &&
        isOptNumber(data, 'averageFinal', 0, 100) &&
        isOptString(data, 'level', 60) &&
        isOptString(data, 'position', 32) &&
        isOptString(data, 'result', 60) &&
        isOptString(data, 'classTeacherComment', 500) &&
        isOptString(data, 'classTeacherName', 150) &&
        isOptString(data, 'classTeacherInitials', 16) &&
        isOptString(data, 'bursarComment', 500) &&
        isOptString(data, 'bursarName', 150) &&
        isOptString(data, 'bursarInitials', 16) &&
        isOptString(data, 'headTeacherComment', 500) &&
        isOptString(data, 'headTeacherName', 150) &&
        isOptString(data, 'projectSubject', 100) &&
        isOptString(data, 'projectTitle', 250) &&
        isOptString(data, 'projectPhase', 100) &&
        isOptNumber(data, 'projectScore', 0, 100) &&
        isOptString(data, 'projectRemarks', 400) &&
        isOptString(data, 'projectSupervisor', 150) &&
        isBoundedList(data.authorizedTeacherUids, 35) &&
        isBoundedList(data.adminUids, 15) &&
        data.status in ['draft', 'ready', 'published'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'classCode', 'academicYearId', 'termId', 'date', 'status', 'recordedByUid', 'authorizedTeacherUids', 'adminUids', 'createdAt']) &&
        data.keys().hasOnly(['id', 'studentId', 'studentName', 'studentAuthUid', 'classCode', 'stream', 'academicYearId', 'termId', 'date', 'status', 'recordedByUid', 'recordedByName', 'authorizedTeacherUids', 'adminUids', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.studentId) &&
        data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 160 &&
        isOptString(data, 'studentAuthUid', 128) &&
        data.classCode in ['S.1', 'S.2', 'S.3', 'S.4', 'S.5', 'S.6'] &&
        isOptString(data, 'stream', 40) &&
        isValidId(data.academicYearId) &&
        isValidId(data.termId) &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
        data.status in ['present', 'absent'] &&
        isValidId(data.recordedByUid) &&
        isOptString(data, 'recordedByName', 150) &&
        isBoundedList(data.authorizedTeacherUids, 35) &&
        isBoundedList(data.adminUids, 15) &&
        data.createdAt is timestamp;
    }

    function isValidFeesRecord(data) {
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'schoolPayCode', 'classCode', 'academicYearId', 'termId', 'feesRequired', 'amountPaid', 'balance', 'adminUids', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'studentId', 'studentName', 'schoolPayCode', 'studentAuthUid', 'classCode', 'stream', 'academicYearId', 'termId', 'feesRequired', 'amountPaid', 'balance', 'bursarComment', 'bursarName', 'bursarInitials', 'paymentHistory', 'adminUids', 'updatedByUid', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.studentId) &&
        data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 160 &&
        data.schoolPayCode is string && data.schoolPayCode.size() <= 64 &&
        isOptString(data, 'studentAuthUid', 128) &&
        data.classCode in ['S.1', 'S.2', 'S.3', 'S.4', 'S.5', 'S.6'] &&
        isOptString(data, 'stream', 40) &&
        isValidId(data.academicYearId) &&
        isValidId(data.termId) &&
        (data.feesRequired is int || data.feesRequired is float) && data.feesRequired >= 0 &&
        (data.amountPaid is int || data.amountPaid is float) && data.amountPaid >= 0 &&
        (data.balance is int || data.balance is float) &&
        isOptString(data, 'bursarComment', 500) &&
        isOptString(data, 'bursarName', 150) &&
        isOptString(data, 'bursarInitials', 16) &&
        (!( 'paymentHistory' in data ) || (data.paymentHistory is list && data.paymentHistory.size() <= 30)) &&
        isBoundedList(data.adminUids, 15) &&
        isOptString(data, 'updatedByUid', 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReportCard(data) {
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'classCode', 'academicYearId', 'termId', 'subjectResults', 'published', 'adminUids', 'generatedAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'studentId', 'studentName', 'studentAuthUid', 'photoUrl', 'gender', 'schoolPayCode', 'classCode', 'stream', 'academicYearId', 'academicYearName', 'termId', 'termName', 'subjectResults', 'attendance', 'fees', 'summary', 'project', 'thisTermHas', 'nextTermBegins', 'published', 'publishedBy', 'missingFields', 'adminUids', 'generatedAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.studentId) &&
        data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 160 &&
        isOptString(data, 'studentAuthUid', 128) &&
        isOptString(data, 'photoUrl', 100000) &&
        isOptString(data, 'gender', 8) &&
        isOptString(data, 'schoolPayCode', 64) &&
        data.classCode in ['S.1', 'S.2', 'S.3', 'S.4', 'S.5', 'S.6'] &&
        isOptString(data, 'stream', 40) &&
        isValidId(data.academicYearId) &&
        isOptString(data, 'academicYearName', 40) &&
        isValidId(data.termId) &&
        isOptString(data, 'termName', 20) &&
        data.subjectResults is list && data.subjectResults.size() <= 25 &&
        (!( 'attendance' in data ) || data.attendance is map) &&
        (!( 'fees' in data ) || data.fees is map) &&
        (!( 'summary' in data ) || data.summary is map) &&
        (!( 'project' in data ) || data.project is map) &&
        isOptString(data, 'thisTermHas', 200) &&
        isOptString(data, 'nextTermBegins', 120) &&
        data.published is bool &&
        isOptString(data, 'publishedBy', 128) &&
        (!( 'missingFields' in data ) || isBoundedList(data.missingFields, 40)) &&
        isBoundedList(data.adminUids, 15) &&
        data.generatedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExcelImport(data) {
      return data.keys().hasAll(['id', 'fileName', 'academicYearId', 'termId', 'classCode', 'sheetsFound', 'rowCount', 'importedCount', 'uploadedByUid', 'adminUids', 'createdAt']) &&
        data.keys().hasOnly(['id', 'fileName', 'academicYearId', 'termId', 'classCode', 'stream', 'sheetsFound', 'rowCount', 'importedCount', 'warnings', 'conflictFlags', 'rawPreviewRows', 'uploadedByUid', 'uploadedByEmail', 'adminUids', 'createdAt']) &&
        isValidId(data.id) &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200 &&
        isValidId(data.academicYearId) &&
        isValidId(data.termId) &&
        data.classCode in ['S.1', 'S.2', 'S.3', 'S.4', 'S.5', 'S.6'] &&
        isOptString(data, 'stream', 40) &&
        isBoundedList(data.sheetsFound, 20) &&
        (data.rowCount is int || data.rowCount is float) && data.rowCount >= 0 &&
        (data.importedCount is int || data.importedCount is float) && data.importedCount >= 0 &&
        (!( 'warnings' in data ) || isBoundedList(data.warnings, 100)) &&
        (!( 'conflictFlags' in data ) || isBoundedList(data.conflictFlags, 100)) &&
        (!( 'rawPreviewRows' in data ) || (data.rawPreviewRows is list && data.rawPreviewRows.size() <= 50)) &&
        isValidId(data.uploadedByUid) &&
        isOptString(data, 'uploadedByEmail', 200) &&
        isBoundedList(data.adminUids, 15) &&
        data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'actorUid', 'actorEmail', 'actorRole', 'action', 'entityType', 'entityId', 'details', 'adminUids', 'createdAt']) &&
        data.keys().hasOnly(['id', 'actorUid', 'actorEmail', 'actorRole', 'action', 'entityType', 'entityId', 'details', 'adminUids', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.actorUid) &&
        data.actorEmail is string && data.actorEmail.size() <= 200 &&
        data.actorRole in ['admin', 'teacher', 'student'] &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 120 &&
        data.entityType is string && data.entityType.size() >= 1 && data.entityType.size() <= 64 &&
        isValidId(data.entityId) &&
        data.details is string && data.details.size() <= 1000 &&
        isBoundedList(data.adminUids, 15) &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules

    match /admins/{adminId} {
      allow get: if isVerified() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isVerified() && isValidId(adminId) && isValidAdmin(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time &&
        (isAdmin() || (isBootstrappedAdmin() && request.auth.uid == adminId));
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminId) && adminId != request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        resource.data.uid == request.auth.uid ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids)
      );
      allow create: if isVerified() && isValidId(userId) && isValidUserAccount(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (isAdmin() && incoming().uid == userId) ||
          (
            request.auth.uid == userId &&
            incoming().uid == request.auth.uid &&
            incoming().email == request.auth.token.email && (
              (isBootstrappedAdmin() && incoming().role == 'admin' && incoming().status == 'active') ||
              (incoming().role == 'pending' && incoming().status == 'pending') ||
              (
                'inviteId' in incoming() &&
                isValidId(incoming().inviteId) &&
                exists(/databases/$(database)/documents/userInvites/$(incoming().inviteId)) &&
                get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.email == request.auth.token.email &&
                get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.status == 'pending' &&
                incoming().role == get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.role &&
                incoming().status == 'active'
              )
            )
          )
        );
      allow update: if isVerified() && isValidId(userId) && isValidUserAccount(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'status', 'linkedEntityId', 'schoolPayCode', 'initials', 'adminUids', 'updatedAt'])) ||
          (
            request.auth.uid == userId &&
            incoming().email == existing().email &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          ) ||
          (
            request.auth.uid == userId &&
            existing().role == 'pending' &&
            'inviteId' in incoming() &&
            isValidId(incoming().inviteId) &&
            exists(/databases/$(database)/documents/userInvites/$(incoming().inviteId)) &&
            get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.email == request.auth.token.email &&
            get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.status == 'pending' &&
            incoming().role == get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.role &&
            incoming().status == 'active' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'linkedEntityId', 'schoolPayCode', 'initials', 'inviteId', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId) && userId != request.auth.uid;
    }

    match /userInvites/{inviteId} {
      allow get: if isVerified() && isValidId(inviteId) && (isAdmin() || resource.data.email == request.auth.token.email);
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        resource.data.email == request.auth.token.email ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids)
      );
      allow create: if isAdmin() && isValidId(inviteId) && isValidUserInvite(incoming()) &&
        incoming().id == inviteId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(inviteId) && isValidUserInvite(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().email == request.auth.token.email &&
            existing().status == 'pending' &&
            incoming().status == 'claimed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(inviteId);
    }

    match /schoolSettings/{settingId} {
      allow get: if isVerified() && isValidId(settingId);
      allow list: if isVerified() && resource.data.schoolCode == 'CSS_KASESE';
      allow create: if isAdmin() && isValidId(settingId) && isValidSchoolSettings(incoming()) &&
        incoming().id == settingId &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(settingId) && isValidSchoolSettings(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /academicYears/{yearId} {
      allow get: if isVerified() && isValidId(yearId);
      allow list: if isVerified() && resource.data.schoolCode == 'CSS_KASESE';
      allow create: if isAdmin() && isValidId(yearId) && isValidAcademicYear(incoming()) &&
        incoming().id == yearId && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(yearId) && isValidAcademicYear(incoming()) &&
        incoming().id == existing().id && incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'isCurrent', 'status']);
      allow delete: if isAdmin() && isValidId(yearId);
