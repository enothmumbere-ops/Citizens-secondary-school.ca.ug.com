    match /terms/{termId} {
      allow get: if isVerified() && isValidId(termId);
      allow list: if isVerified() && resource.data.schoolCode == 'CSS_KASESE';
      allow create: if isAdmin() && isValidId(termId) && isValidTerm(incoming()) &&
        incoming().id == termId && incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/academicYears/$(incoming().academicYearId));
      allow update: if isAdmin() && isValidId(termId) && isValidTerm(incoming()) &&
        incoming().id == existing().id && incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'startDate', 'endDate', 'nextTermBegins', 'isCurrent']);
      allow delete: if isAdmin() && isValidId(termId);
