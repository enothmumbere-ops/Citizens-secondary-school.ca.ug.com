      allow update: if isAdmin() && isValidId(classId) && isValidSchoolClass(incoming()) &&
        incoming().id == existing().id && incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'level', 'streams', 'classTeacherId', 'classTeacherName', 'classTeacherInitials']);
