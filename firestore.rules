    match /classes/{classId} {
      allow get: if isVerified() && isValidId(classId);
      allow list: if isVerified() && resource.data.schoolCode == 'CSS_KASESE';
      allow create: if isAdmin() && isValidId(classId) && isValidSchoolClass(incoming()) &&
