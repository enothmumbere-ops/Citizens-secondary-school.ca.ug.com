    match /teachers/{teacherId} {
      allow get: if isVerified() && isValidId(teacherId) && (isAdmin() || resource.data.authUid == request.auth.uid);
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        resource.data.authUid == request.auth.uid ||
        (resource.data.adminUids is list && request.auth.uid in resource.data.adminUids)
